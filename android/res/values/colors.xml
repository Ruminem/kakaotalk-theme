<?xml version="1.0" encoding="utf-8"?>
<!--
  먹빛 민트 — 안드로이드 카카오톡 테마 (색만)

  이름은 카카오 공식 테마 가이드(9.2.5 Android)에 정의된 것 그대로다.
  없는 이름을 만들어 넣으면 무시되고, 빠뜨린 항목은 카톡 기본값이 나온다.
  iOS 와 달리 말풍선을 PNG 없이 색으로 지정할 수 있다.

  #101215 바닥 / #16181C 기본 / #1E2126 한 단계 위 / #242830 눌림
  #2A2E35 구분선 / #E8EBEE 본문 / #98A1AB 보조 / #4FD1B0 민트 / #2E9E85 민트 눌림
-->
<resources>

    <!-- 전체 배경 -->
    <color name="theme_background_color">#FF16181C</color>

    <!-- 상단 헤더 -->
    <color name="theme_header_color">#FFE8EBEE</color>
    <color name="theme_header_cell_color">#FF16181C</color>
    <color name="theme_tab_bannerbadge_background_color">#FF4FD1B0</color>

